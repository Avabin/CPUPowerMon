<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CpuMon.Core\CpuMon.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.1" />
    <PackageReference Include="Tmds.DBus.Generator" Version="0.95.1" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="dbus-xml/org.cpupowermon.CpuMon1.xml"
                     Namespace="CpuMon.Client.DBus"
                     DBusGeneratorMode="Proxy" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Version>0.1.0</Version>
    <AssemblyName>cpumonctl</AssemblyName>
    <RootNamespace>CpuMon.Client</RootNamespace>
  </PropertyGroup>

</Project>
